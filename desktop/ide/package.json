{
  "name": "edorax-ide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "theia build --mode production && theia download:plugins --ignore-errors",
    "download:plugins": "theia download:plugins --ignore-errors",
    "start": "theia start --hostname=127.0.0.1 --plugins=local-dir:plugins"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Edorax Workspace",
        "defaultTheme": {
          "light": "Default Light Modern",
          "dark": "Default Dark Modern"
        },
        "defaultIconTheme": "material-icon-theme",
        "preferences": {
          "workbench.startupEditor": "none",
          "window.menuBarVisibility": "classic",
          "editor.minimap.enabled": false,
          "editor.fontSize": 13,
          "editor.lineHeight": 22,
          "editor.scrollBeyondLastLine": false,
          "editor.bracketPairColorization.enabled": true,
          "editor.guides.bracketPairs": "active",
          "editor.linkedEditing": true,
          "editor.suggestSelection": "first",
          "editor.tabSize": 2,
          "files.autoSave": "afterDelay",
          "files.autoSaveDelay": 500
        }
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.theme-defaults": "https://open-vsx.org/api/vscode/theme-defaults/1.95.3/file/vscode.theme-defaults-1.95.3.vsix",
    "vscode.theme-monokai": "https://open-vsx.org/api/vscode/theme-monokai/1.95.3/file/vscode.theme-monokai-1.95.3.vsix",
    "vscode.theme-monokai-dimmed": "https://open-vsx.org/api/vscode/theme-monokai-dimmed/1.95.3/file/vscode.theme-monokai-dimmed-1.95.3.vsix",
    "vscode.theme-solarized-dark": "https://open-vsx.org/api/vscode/theme-solarized-dark/1.95.3/file/vscode.theme-solarized-dark-1.95.3.vsix",
    "vscode.theme-solarized-light": "https://open-vsx.org/api/vscode/theme-solarized-light/1.95.3/file/vscode.theme-solarized-light-1.95.3.vsix",
    "vscode.theme-abyss": "https://open-vsx.org/api/vscode/theme-abyss/1.95.3/file/vscode.theme-abyss-1.95.3.vsix",
    "vscode.theme-kimbie-dark": "https://open-vsx.org/api/vscode/theme-kimbie-dark/1.95.3/file/vscode.theme-kimbie-dark-1.95.3.vsix",
    "vscode.theme-quietlight": "https://open-vsx.org/api/vscode/theme-quietlight/1.95.3/file/vscode.theme-quietlight-1.95.3.vsix",
    "vscode.theme-red": "https://open-vsx.org/api/vscode/theme-red/1.95.3/file/vscode.theme-red-1.95.3.vsix",
    "vscode.theme-tomorrow-night-blue": "https://open-vsx.org/api/vscode/theme-tomorrow-night-blue/1.95.3/file/vscode.theme-tomorrow-night-blue-1.95.3.vsix",
    "vscode.vscode-theme-seti": "https://open-vsx.org/api/vscode/vscode-theme-seti/1.95.3/file/vscode.vscode-theme-seti-1.95.3.vsix",
    "dracula-theme.theme-dracula": "https://open-vsx.org/api/dracula-theme/theme-dracula/2.25.1/file/dracula-theme.theme-dracula-2.25.1.vsix",
    "zhuangtongfa.material-theme": "https://open-vsx.org/api/zhuangtongfa/material-theme/3.20.6/file/zhuangtongfa.material-theme-3.20.6.vsix",
    "PKief.material-icon-theme": "https://open-vsx.org/api/PKief/material-icon-theme/5.40.0/file/PKief.material-icon-theme-5.40.0.vsix",
